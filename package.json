{
  "name": "sogit-muse-studio",
  "version": "0.3.0",
  "private": true,
  "description": "Studio desktop cho phim storytelling — dự án, reference, phân cảnh và hậu kỳ",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "desktop": "node scripts/desktop.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:dir": "npm run build && electron-builder --dir",
    "test:desktop": "node tests/desktop.mjs",
    "dist:zip": "npm run build && electron-builder --win zip --x64 --config.win.signAndEditExecutable=false",
    "test:muse": "node tests/muse-desktop.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "vn.sogit.musestudio",
    "productName": "SogiT Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "extraFiles": [
      {
        "from": "docs/QUICK_START_VI.txt",
        "to": "HUONG_DAN.txt"
      }
    ]
  },
  "license": "UNLICENSED",
  "author": "SogiT Studio"
}
